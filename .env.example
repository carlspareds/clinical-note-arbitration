# ==============================================================================
# Clinical Note Arbitration - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and insert your relevant API keys.
# Offline evaluation and mock testing do NOT require any API keys.

# Primary LLM Provider API Keys (optional if using local Ollama or mock mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# DigitalOcean Gradient / Custom OpenAI-compatible endpoints
DO_GRADIENT_API_KEY=
CUSTOM_OPENAI_BASE_URL=https://inference.do-ai.run/v1

# Local Ollama Configuration (defaults to localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3.2

# Default Arbiter Models
DEFAULT_GENERATOR_MODEL_A=openai/gpt-4o-mini
DEFAULT_GENERATOR_MODEL_B=anthropic/claude-3-5-haiku-latest
DEFAULT_JUDGE_MODEL=openai/gpt-4o

# Execution Settings
ARBITER_TIMEOUT_SECONDS=60
ARBITER_MAX_RETRIES=3
ARBITER_LOG_LEVEL=INFO
